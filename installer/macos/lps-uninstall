#!/bin/sh
# Remove LPS installed from its macOS package: sudo lps-uninstall
#
# Stops LPS for every user and removes its launch agents and program files.
# Your data (~/Library/Application Support/LPS), and the VPS and apps in
# Docker, are kept, so reinstalling picks them up.
set -e
label=com.abrardw.lps
if [ "$(id -u)" -ne 0 ]; then
	echo "Run it with sudo: sudo lps-uninstall" >&2
	exit 1
fi
for plist in /Users/*/Library/LaunchAgents/$label.plist; do
	[ -f "$plist" ] || continue
	uid=$(stat -f%u "$plist")
	launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
	rm -f "$plist"
	echo "Stopped LPS for $(stat -f%Su "$(dirname "$plist")" 2>/dev/null || echo "uid $uid")"
done
rm -f /usr/local/bin/lpsd /usr/local/bin/lps-uninstall
pkgutil --forget $label >/dev/null 2>&1 || true
echo "LPS is removed. Your data in ~/Library/Application Support/LPS is kept."
